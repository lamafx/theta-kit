{#- En-tête, pied de page et marques communes à toutes les pages. -#}
{%- macro entete(numero, chapitre, droite) -%}
<div class="entete">
<span class="gauche"><span class="numero">{{ numero|typo }}</span><span class="chapitre">{{ chapitre|typo }}</span></span>
{{ droite }}
</div>
{%- endmacro %}
{%- macro pagination(page) -%}
<span class="pagination">{{ page.numero }} / {{ page.total }}</span>
{%- endmacro %}
{%- macro serie() -%}
<span class="serie"><span class="theta">θ</span>Théta</span>
{%- endmacro %}
{%- macro pied(signature, glissez=True, fleche=22) -%}
<div class="pied">
<span class="signature">{{ signature }}</span>
{% if glissez -%}
<span class="glissez">
<span>Glissez</span>
<svg width="{{ fleche }}" height="{{ fleche }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color: var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
</span>
{%- endif %}
</div>
{%- endmacro %}
