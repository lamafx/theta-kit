<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<style>
{{ polices }}
body{margin:0}
</style>
</head>
<body>
{#- Planche de contrôle d'une famille (session de design n° 1) : chaque forme de page de bibliotheque/,
    à sa taille réelle (920 px de large), avec les paramètres de tests/fixtures/formes.yaml. -#}
<div style="width: 1080px; height: {{ hauteur }}px; box-sizing: border-box; padding: 64px 80px 56px; background: {{ cl.fond }}; color: {{ cl.texte }}; font-family: 'Geist', sans-serif; display: flex; flex-direction: column; gap: 40px; overflow: hidden">

<div style="display: flex; flex-direction: column; gap: 10px">
<span style="font-family: 'Geist Mono', monospace; font-size: 16px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: {{ cl.accent }}">Bibliothèque · formes de page</span>
<h1 style="margin: 0; font-size: 46px; line-height: 1.05; font-weight: 600; letter-spacing: -0.03em">{{ titre }}</h1>
</div>
{% for f in formes %}

<div style="display: flex; flex-direction: column; gap: 20px; border-top: 1px solid {{ cl.filet }}; padding-top: 20px">
<span style="font-family: 'Geist Mono', monospace; font-size: 15px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: {{ cl.secondaire }}">{{ f.legende }}</span>
{% if f.cas %}
<div style="display: grid; grid-template-columns: repeat({{ f.cas|length }}, minmax(0, 1fr)); gap: 40px">
{% for svg in f.cas %}
{{ svg }}
{% endfor %}
</div>
{% else %}
{{ f.svg }}
{% endif %}
</div>
{% endfor %}

</div>
</body>
</html>
