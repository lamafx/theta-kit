<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<style>
{{ polices }}
body{margin:0}
</style>
</head>
<body>
{#- Planche de contrôle : reprend la mise en page de design/canevas-gabarits/Bib-Motifs.dc.html
    pour vérifier que les vignettes de bibliotheque/ (thème couverture) dessinent la même chose. -#}
<div style="width: 1080px; height: 1350px; box-sizing: border-box; padding: 64px 80px 56px; background: {{ co.fond }}; color: {{ co.texte }}; font-family: 'Geist', sans-serif; display: flex; flex-direction: column; gap: 28px; overflow: hidden">

<div style="display: flex; flex-direction: column; gap: 10px">
<span style="font-family: 'Geist Mono', monospace; font-size: 16px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: {{ co.accent }}">Bibliothèque · fond derrière le robot</span>
<h1 style="margin: 0; font-size: 46px; line-height: 1.05; font-weight: 600; letter-spacing: -0.03em">8 motifs pour 62 couvertures</h1>
<p style="margin: 0; font-size: 20px; line-height: 1.4; color: {{ co.texte_courant }}">Chaque épisode choisit une famille et ses paramètres. Aucun motif n’est inventé hors de cette liste.</p>
</div>

<div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px">
{% for f in familles %}

<div style="background: {{ co.carte }}; border: 1px solid {{ bord_carte }}; border-radius: 18px; padding: 14px 20px 14px; display: flex; flex-direction: column; gap: 10px">
{{ f.svg }}
<div style="display: flex; justify-content: space-between; align-items: baseline"><span style="font-size: 20px; font-weight: 600">{{ f.nom }}</span><span style="font-family: 'Geist Mono', monospace; font-size: 13px; color: {{ co.secondaire }}">{{ f.compte }}</span></div>
<span style="font-family: 'Geist Mono', monospace; font-size: 13px; line-height: 1.5; color: {{ co.secondaire }}">{{ f.parametres }}</span>
</div>
{% endfor %}

</div>
</div>
</body>
</html>
