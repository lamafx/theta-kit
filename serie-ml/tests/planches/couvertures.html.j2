<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<style>
{{ polices }}
{{ style }}
body{margin:0}
</style>
</head>
<body>
{#- Planche des fonds de couverture (A11) : chaque couverture rendue par le gabarit, réduite à 45 %. -#}
<div style="width: 1080px; height: {{ hauteur }}px; box-sizing: border-box; padding: 64px 40px 56px; background: {{ co.fond }}; color: {{ co.texte }}; font-family: 'Geist', sans-serif; display: flex; flex-direction: column; gap: 40px; overflow: hidden">

<div style="display: flex; flex-direction: column; gap: 10px; padding: 0 40px">
<span style="font-family: 'Geist Mono', monospace; font-size: 16px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: {{ co.accent }}">Bibliothèque · fonds de couverture</span>
<h1 style="margin: 0; font-size: 46px; line-height: 1.05; font-weight: 600; letter-spacing: -0.03em">8 familles, un motif chacune</h1>
</div>

<div style="display: grid; grid-template-columns: repeat(2, 486px); gap: 32px 28px">
{% for c in couvertures %}
<div style="display: flex; flex-direction: column; gap: 10px">
<div style="width: 486px; height: 607.5px; overflow: hidden; border: 1px solid {{ co.filet }}; box-sizing: content-box">
<div style="width: 1080px; height: 1350px; transform: scale(0.45); transform-origin: 0 0">
{{ c.page }}
</div>
</div>
<span style="font-family: 'Geist Mono', monospace; font-size: 15px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: {{ co.secondaire }}">{{ c.legende }}</span>
</div>
{% endfor %}
</div>

</div>
</body>
</html>
